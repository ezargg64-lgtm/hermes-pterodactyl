# Contoh konfigurasi minimum untuk Hermes Agent gateway di Pterodactyl.
# Salin isinya ke salah satu:
#   A) Environment Variables di tab Startup panel (cara utama, paling aman), atau
#   B) file ~/hermes-agent/.env (installer sudah membuatkannya dari template resmi)
#
# Hapus tanda # di baris yang dipakai. Jangan pernah commit file .env asli.

# ---------------------------------------------------------------------------
# 1) WAJIB: API key LLM (pilih salah satu provider)
# ---------------------------------------------------------------------------
# OpenRouter — satu key untuk banyak model termasuk Hermes: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Atau API key provider lain yang didukung (lihat ~/hermes-agent/.env.example lengkap):
# FIREWORKS_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Model default diatur lewat config (~/.hermes/config.yaml), atau interaktif:
#   hermes model
# Perintah config non-interaktif:
#   hermes config set model.default openrouter/nama-model

# ---------------------------------------------------------------------------
# 2) WAJIB untuk gateway: pilih platform messaging (satu atau lebih)
#    Telegram direkomendasikan di Pterodactyl: long-polling, TANPA port publik.
# ---------------------------------------------------------------------------

# Telegram (buat bot via @BotFather):
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyz
# TELEGRAM_ALLOWED_USERS=123456789
# TELEGRAM_HOME_CHANNEL=123456789

# Discord (Developer Portal -> Bot -> Reset Token; nyalakan Message Content Intent):
# DISCORD_BOT_TOKEN=
# DISCORD_ALLOWED_USERS=

# Slack (Socket Mode, tanpa inbound port):
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...

# WhatsApp (bridge Baileys, pairing lewat perintah: hermes whatsapp):
# WHATSAPP_ENABLED=false

# Pagar aman: jangan buka gateway untuk semua orang tanpa izin eksplisit.
# GATEWAY_ALLOW_ALL_USERS=false

# ---------------------------------------------------------------------------
# 3) Khusus Pterodactyl: terminal tool backend harus 'local'
#    Container ini tidak punya docker socket, jadi backend docker akan gagal.
# ---------------------------------------------------------------------------
TERMINAL_ENV=local
