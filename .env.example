# Salin file ini menjadi .env bila ingin konfigurasi via file.
# Di Pterodactyl lebih disarankan set lewat tab Startup > Environment Variables.

# Nama agent yang muncul di log
HERMES_NAME=hermes-agent

# Interval tick dalam milidetik (60000 = 60 detik)
HERMES_TICK_INTERVAL_MS=60000

NODE_ENV=production
